{
  "name": "story-map-project",
  "version": "1.0.0",
  "description": "A geospatial story map of student homelessness, housing stability and educational continuity in New York City.",
  "main": "index.js",
  "type": "module",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "python3 scripts/audit_evidence.py && node --test tests/*.test.js && npm run lint",
    "lint": "eslint . && stylelint '**/*.css'",
    "test:browser": "node scripts/check-browser.mjs",
    "validate:geometry": "python3 scripts/validate_geometry.py",
    "metadata": "python3 scripts/build_release_metadata.py",
    "start": "python3 -m http.server 8000"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
